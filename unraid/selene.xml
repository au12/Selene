<?xml version="1.0"?>
<Container version="2">
  <Name>selene</Name>
  <Repository>ghcr.io/au12/selene:latest</Repository>
  <Registry>https://github.com/au12/selene/pkgs/container/selene</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/au12/selene/issues</Support>
  <Project>https://github.com/au12/selene</Project>
  <Overview>Selene — an interactive moon-data LCD watch and desk-clock simulator. Moon phase arc, moon hour-angle times, sunrise/sunset for any date, alarm, hourly chime, stopwatch and a time machine. Fully offline, no data stored server-side.</Overview>
  <Category>Tools: Other:</Category>
  <WebUI>http://[IP]:[PORT:80]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/au12/selene/main/unraid/selene.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/au12/selene/main/assets/icon-512.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Web UI port" Target="80" Default="8087" Mode="tcp" Description="Port for the web interface" Type="Port" Display="always" Required="true" Mask="false">8087</Config>
</Container>
